# Green Gold Wheels API — ortam degiskenleri
# Bu dosya SADECE placeholder icerir. Gercek degerler .env dosyasina yazilir
# (.gitignore'da) ve ASLA commit edilmez.

# ---------------------------------------------------------------------------
# VERITABANI (Neon Postgres) — IKI AYRI ROL, IKI AYRI ADRES
# ---------------------------------------------------------------------------

# CALISMA ZAMANI: kisitli wheels_app rolu, Neon HAVUZLU (-pooler) adresi.
# Bu degeri ELLE YAZMAYIN — `npm run setup-app-role` uretir, dogrular ve basar.
# Vercel'e konan TEK veritabani adresi budur. Uygulama acilista bu rolun
# RLS'e tabi oldugunu dogrular; degilse (or. sahip adresi yazilmissa) ACILMAZ.
DATABASE_URL=postgresql://wheels_app:URETILECEK@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# OPERATOR: tablo sahibi (Neon Console -> Connect -> rol neondb_owner,
# "Connection pooling" KAPALI). YALNIZCA migrate ve operator script'leri
# kullanir; RLS'i atlar.
# !! Vercel'e / sunucuya / CI'a ASLA KONMAZ. Yalnizca senin makinende durur.
DATABASE_URL_OWNER=postgresql://neondb_owner:SIFRE@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# KIMLIK DOGRULAMA (Neon Auth = Managed Better Auth)
# ---------------------------------------------------------------------------

# Neon Console -> Settings -> Auth -> "Auth URL" alanini BIREBIR kopyalayin.
# YOL KISMI DAHIL (.../neondb/auth) — origin tek basina YANLISTIR:
# JWKS ucu bu URL in ALTINDADIR (<AuthURL>/.well-known/jwks.json).
# Dogrulamak icin: npm run check-auth
# Uretimde https zorunlu, aksi halde uygulama acilmaz.
NEON_AUTH_BASE_URL=https://ep-XXXX.neonauth.c-2.REGION.aws.neon.tech/neondb/auth

# OPSIYONEL ek dogrulama katlari. Imza kontrolu zaten zorunlu ve tek basina
# kimligi garanti eder (token yalnizca SENIN projenin anahtariyla dogrulanir).
# Bu ikisi, gercek bir token elde edilince claim lerine bakilip doldurulabilir.
NEON_AUTH_ISSUER=
NEON_AUTH_AUDIENCE=

# ---------------------------------------------------------------------------
# DIGER
# ---------------------------------------------------------------------------

# Lokal port (opsiyonel, varsayilan 3000)
PORT=3000

# Panelin origin'i (virgulle birden fazla). Panelin "Musteri Onizleme" ve
# public /demo sayfalari widget'i panelin domain'inde cizer. Bu origin'e
# YALNIZCA GET (config/impact) izni verilir; POST /widget/events ASLA —
# onizlemeden rapora event yazilamaz. Lokalde gerekmez (localhost serbest).
# Ornek: WIDGET_PREVIEW_ORIGINS=https://panel.greengold.com
WIDGET_PREVIEW_ORIGINS=

# Dagitik rate limit (opsiyonel ama COK-INSTANCE deploy'da ZORUNLU).
# Yoksa rate limit bellek-ici best-effort'a duser ve acilista uyari loglar.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
