# Panel ortam degiskenleri — .env.local GIT ICINDE DEGIL.

# Neon Auth (API ile AYNI deger — .env dosyasindaki NEON_AUTH_BASE_URL).
NEON_AUTH_BASE_URL=https://ep-XXXX.neonauth.c-2.REGION.aws.neon.tech/neondb/auth
# Tarayici tarafinin ihtiyac duydugu ayni adres.
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-XXXX.neonauth.c-2.REGION.aws.neon.tech/neondb/auth

# Oturum cerezlerini imzalar. Min 32 karakter. Bu dosyaya ozel uretildi.
NEON_AUTH_COOKIE_SECRET=<openssl rand -base64 32 ile uretin>

# Panelin konustugu API (green-gold-wheels-api).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000

# Panelin kendi adresi — Entegrasyon ekranindaki embed kodu widget script'ini
# buradan gosterir (<SITE_URL>/green-gold-wheels-widget.v1.js).
# Ayri bir CDN kullanilacaksa onun yerine NEXT_PUBLIC_WIDGET_SRC verin.
NEXT_PUBLIC_SITE_URL=http://localhost:3001
# NEXT_PUBLIC_WIDGET_SRC=https://cdn.ornek.com/green-gold-wheels-widget.v1.js

# --- Demo girisi (Stay'deki "Demo panelini goruntule") ---
# Bilgiler YALNIZCA sunucuda okunur; tarayiciya gitmez. Hesap salt okunurdur
# (demo_viewer) ve ayri bir demo sirketine baglidir — API klasorunde:
#   npm run setup-demo
DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_EMAIL=demo@greengold-wheels.test
DEMO_LOGIN_PASSWORD=<en az 12 karakter, sizin belirlediginiz>
# setup-demo ciktisindaki anahtar — public /demo sayfasi icin.
NEXT_PUBLIC_DEMO_WIDGET_KEY=
